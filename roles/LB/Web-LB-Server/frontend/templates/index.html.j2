<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8">
    <title>Beat Visual: VIBE SELECTOR</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/ShaderPass.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js"></script>

    <style>
        /* [UI 스타일: 기존 핑크/블루/화이트 테마 유지] */
        body { background-color: #000; margin: 0; padding: 0; overflow: hidden; height: 100vh; display: flex; align-items: center; justify-content: center; font-family: 'Montserrat', sans-serif; }
        #visualization-container { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; background-color: #000; }
        
        .container { 
            background-color: rgba(0, 0, 0, 0.85); backdrop-filter: blur(12px); 
            padding: 40px; border-radius: 20px; text-align: center; width: 480px; 
            border: 1px solid rgba(255, 255, 255, 0.15); 
            z-index: 100; position: relative; 
            box-shadow: 0 0 50px rgba(0,0,0,0.8); 
        }
        h1 { margin: 0 0 5px 0; font-size: 32px; color: #fff; font-weight: 800; letter-spacing: 2px; text-shadow: 0 0 10px rgba(255, 255, 255, 0.5); }
        p { color: #888; margin-bottom: 25px; font-size: 13px; text-transform: uppercase; letter-spacing: 1px; }
        
        input[type="file"] { 
            width: 100%; padding: 15px; margin-bottom: 20px; background: #1a1a1a; 
            border: 1px solid #333; border-radius: 8px; color: #ccc; cursor: pointer; 
            box-sizing: border-box; font-size: 14px; text-align: center; 
        }
        
        /* 테마 선택 UI */
        .theme-label { text-align: left; color: #fff; font-size: 12px; font-weight: bold; margin-bottom: 10px; display: block; }
        .theme-selector { display: flex; gap: 10px; margin-bottom: 25px; }
        .theme-option { flex: 1; position: relative; }
        .theme-option input { position: absolute; opacity: 0; cursor: pointer; }
        
        .theme-card {
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            height: 80px; background: #222; border: 1px solid #444; border-radius: 8px;
            cursor: pointer; transition: 0.3s; color: #666;
        }
        .theme-icon { font-size: 24px; margin-bottom: 5px; }
        .theme-name { font-size: 10px; font-weight: bold; }
        
        /* 선택된 상태 스타일 */
        .theme-option input:checked + .theme-card { background: linear-gradient(135deg, #222, #333); border-color: #00dbde; color: #fff; box-shadow: 0 0 15px rgba(0, 219, 222, 0.3); }
        
        /* 1번: Sunset (핑크) */
        .theme-option:nth-child(1) input:checked + .theme-card { border-color: #ff00de; box-shadow: 0 0 15px rgba(255, 0, 222, 0.4); }
        /* 2번: Pixel (오렌지/옐로우 - 교체됨) */
        .theme-option:nth-child(2) input:checked + .theme-card { border-color: #ffaa00; box-shadow: 0 0 15px rgba(255, 170, 0, 0.4); }
        /* 3번: Matrix (그린) */
        .theme-option:nth-child(3) input:checked + .theme-card { border-color: #00ff00; box-shadow: 0 0 15px rgba(0, 255, 0, 0.4); }

        .submit-btn { background: #fff; color: #000; border: none; border-radius: 8px; padding: 16px; width: 100%; font-weight: 800; font-size: 16px; text-transform: uppercase; cursor: pointer; transition: 0.2s; }
        .submit-btn:hover { transform: translateY(-2px); box-shadow: 0 5px 20px rgba(255, 255, 255, 0.3); }

        /* 로딩바 */
        #loading-section { position: absolute; width: 100%; height: 100%; z-index: 200; background: #000; display: none; flex-direction: column; align-items: center; justify-content: center; }
        .loader-text { color: #fff; font-size: 20px; font-weight: bold; letter-spacing: 3px; margin-bottom: 20px; animation: blink 1s infinite; }
        .progress-container { width: 300px; height: 4px; background: #333; border-radius: 2px; overflow: hidden; }
        .progress-bar { width: 0%; height: 100%; background: linear-gradient(90deg, #ff00de, #00dbde); transition: width 0.1s linear; }
        
        /* 결과 화면 UI */
        #result-ui { position: absolute; width: 100%; height: 100%; z-index: 50; display: none; pointer-events: none; }
        .vibe-badge { position: absolute; bottom: 40px; left: 40px; color: #fff; font-size: 3em; font-weight: 900; mix-blend-mode: screen; text-shadow: 0 0 20px rgba(255,255,255,0.5); }
        .vibe-sub { font-size: 14px; display: block; margin-top: 5px; opacity: 0.8; letter-spacing: 2px; }
        
        .music-stats { position: absolute; bottom: 130px; left: 45px; text-align: left; font-family: 'Courier New', monospace; }
        .stat-row { margin-bottom: 6px; color: rgba(255, 255, 255, 0.6); font-size: 12px; letter-spacing: 1px; }
        .stat-value { color: #00dbde; font-weight: bold; font-size: 14px; margin-left: 10px; }

        .restart-btn { position: fixed; bottom: 30px; right: 30px; z-index: 9999; padding: 10px 25px; background: rgba(0, 0, 0, 0.5); border: 1px solid #fff; color: #fff; font-weight: bold; border-radius: 30px; cursor: pointer; pointer-events: auto; }
        .restart-btn:hover { background: #fff; color: #000; }
        
        .server-indicator { position: fixed; top: 20px; right: 20px; color: #0f0; font-family: monospace; font-size: 12px; pointer-events: none; z-index: 9999; }
        
        @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }
    </style>
</head>
<body>
    <div class="server-indicator">NODE: {{ inventory_hostname }}</div>
    <audio id="audio-player" style="display:none"></audio>

    <div id="upload-section" class="container">
        <h1>BEAT VISUALIZER</h1>
        <p>Select your vibe & Play</p>
        
        <form id="uploadForm" onsubmit="handleUpload(event)">
            <input type="file" id="fileInput" name="file" accept="audio/*" required>
            
            <span class="theme-label">SELECT VISUAL THEME</span>
            <div class="theme-selector">
                <label class="theme-option">
                    <input type="radio" name="theme" value="sunset" checked>
                    <div class="theme-card">
                        <div class="theme-icon">🚗</div>
                        <div class="theme-name">SUNSET DRIVE</div>
                    </div>
                </label>
                <label class="theme-option">
                    <input type="radio" name="theme" value="pixel">
                    <div class="theme-card">
                        <div class="theme-icon">👾</div>
                        <div class="theme-name">PIXEL LOFI</div>
                    </div>
                </label>
                <label class="theme-option">
                    <input type="radio" name="theme" value="cyber">
                    <div class="theme-card">
                        <div class="theme-icon">📟</div>
                        <div class="theme-name">CYBER MATRIX</div>
                    </div>
                </label>
            </div>

            <button type="submit" class="submit-btn">START VISUALIZATION</button>
        </form>
    </div>
    
    <div id="loading-section">
        <div class="loader-text">INITIALIZING SYSTEM...</div>
        <div class="progress-container">
            <div id="progress-bar" class="progress-bar"></div>
        </div>
    </div>

    <div id="visualization-container"></div>
    
    <div id="result-ui">
        <div id="music-stats-container" class="music-stats"></div>
        <div id="vibe-display" class="vibe-badge"></div>
        <button class="restart-btn" onclick="location.reload()">QUIT</button>
    </div>

    <script>
        const UPLOAD_URL = '/upload'; 
        const VISUAL_PATH = '/music-project/'; 
        let pollingInterval = null;
        let progressInterval = null;
        let audioPlayer = document.getElementById('audio-player');
        
        async function handleUpload(event) { 
            event.preventDefault(); 
            const fileInput = document.getElementById('fileInput'); 
            const file = fileInput.files[0];
            if (!file) { alert("파일을 선택해주세요."); return; }

            const fileURL = URL.createObjectURL(file);
            audioPlayer.src = fileURL;
            audioPlayer.volume = 0.6;
            audioPlayer.onended = function() { location.reload(); };

            document.getElementById('upload-section').style.display = 'none'; 
            document.getElementById('loading-section').style.display = 'flex'; 
            startLoadingAnimation();

            const formData = new FormData(); 
            formData.append('file', file); 
            
            try { 
                const response = await fetch(UPLOAD_URL, { method: 'POST', body: formData }); 
                if (response.ok) startPolling(); else throw new Error("Upload Failed"); 
            } catch (error) { 
                console.error(error); alert("Server Error"); location.reload(); 
            } 
        }

        function startLoadingAnimation() {
            const bar = document.getElementById('progress-bar');
            let width = 0;
            if(progressInterval) clearInterval(progressInterval);
            progressInterval = setInterval(() => {
                if (width < 90) { width += 0.5; if(bar) bar.style.width = width + '%'; }
            }, 150);
        }

        function startPolling() { 
            setTimeout(() => { 
                pollingInterval = setInterval(async () => { 
                    try { 
                        const res = await fetch(`${VISUAL_PATH}theme.json?t=${Date.now()}`); 
                        if (res.status === 200) { 
                            clearInterval(pollingInterval); clearInterval(progressInterval);
                            document.getElementById('progress-bar').style.width = '100%';
                            
                            audioPlayer.play(); 
                            setTimeout(async () => { renderResult(await res.json()); }, 500);
                        } 
                    } catch (e) {} 
                }, 2000); 
            }, 30000); 
        }

        function renderResult(data) { 
            const topMood = data.emotion_rankings[0]; 
            document.getElementById('vibe-display').innerHTML = `${topMood.mood}<span class="vibe-sub">CONFIDENCE: ${topMood.confidence}</span>`; 
            
            const bpm = data.analysis.tempo || 'N/A';
            const intensity = data.analysis.intensity ? (data.analysis.intensity * 100).toFixed(0) : 0;
            const themeColor = data.palette.main || '#FFF';
            
            document.getElementById('music-stats-container').innerHTML = `
                <div class="stat-row">TEMPO <span class="stat-value">${bpm} BPM</span></div>
                <div class="stat-row">ENERGY <span class="stat-value">${intensity} %</span></div>
                <div class="stat-row">THEME <span class="stat-value" style="color:${themeColor}">${themeColor}</span></div>
            `;

            document.getElementById('loading-section').style.display = 'none'; 
            document.getElementById('result-ui').style.display = 'block'; 

            const selectedTheme = document.querySelector('input[name="theme"]:checked').value;
            
            if (selectedTheme === 'sunset') startSunsetDrive(data);
            else if (selectedTheme === 'pixel') startPixelLofi(data); // 2번
            else if (selectedTheme === 'cyber') startCyberMatrix(data); // 3번
        }

        // ============================================================
        // 🛠️ HELPER
        // ============================================================
        function initThreeJS(data, animationCallback, usePixelArt=false) {
            const container = document.getElementById('visualization-container');
            container.innerHTML = '';

            const cMain = new THREE.Color(data.palette.main);
            const cAccent = new THREE.Color(data.palette.accent);
            const bpm = data.analysis.tempo || 120;

            const scene = new THREE.Scene();
            
            const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            
            // [옵션] 픽셀 아트 모드면 안티앨리어싱 끄기
            const renderer = new THREE.WebGLRenderer({ antialias: !usePixelArt, alpha: false });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.setClearColor(0x000000, 1);
            renderer.toneMapping = THREE.ACESFilmicToneMapping;
            renderer.toneMappingExposure = 1.0; 
            container.appendChild(renderer.domElement);

            const renderScene = new THREE.RenderPass(scene, camera);
            const bloomPass = new THREE.UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.5, 0.4, 0.85);
            bloomPass.threshold = 0.1;
            bloomPass.strength = 0.8;
            bloomPass.radius = 0.5;
            
            const composer = new THREE.EffectComposer(renderer);
            composer.addPass(renderScene);
            composer.addPass(bloomPass);

            const clock = new THREE.Clock();

            function animate() {
                requestAnimationFrame(animate);
                const delta = clock.getDelta();
                const time = clock.getElapsedTime();
                
                let baseIntensity = data.analysis.intensity || 0.5;
                let intensity = baseIntensity + Math.sin(time * (bpm/30)) * 0.1; 
                bloomPass.strength = 0.5 + (intensity * 0.5);

                animationCallback(scene, camera, renderer, composer, cMain, cAccent, intensity, bpm, time, delta);
                composer.render();
            }

            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
                composer.setSize(window.innerWidth, window.innerHeight);
            });
            animate();
        }

        function createGridTexture(color) {
            const canvas = document.createElement('canvas'); canvas.width = 1024; canvas.height = 1024;
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#000000'; ctx.fillRect(0, 0, 1024, 1024);
            ctx.strokeStyle = `rgb(${color.r*255}, ${color.g*255}, ${color.b*255})`;
            ctx.lineWidth = 4; ctx.beginPath();
            for(let i=0; i<=1024; i+=64) { ctx.moveTo(i, 0); ctx.lineTo(i, 1024); ctx.moveTo(0, i); ctx.lineTo(1024, i); }
            ctx.stroke();
            const tex = new THREE.CanvasTexture(canvas);
            tex.wrapS = THREE.RepeatWrapping; tex.wrapT = THREE.RepeatWrapping;
            tex.repeat.set(20, 40); tex.anisotropy = 16;
            return tex;
        }

        function createCarObject(color) {
            const group = new THREE.Group();
            const body = new THREE.Mesh(new THREE.BoxGeometry(2.2, 0.8, 4.5), new THREE.MeshBasicMaterial({ color: 0x111111 }));
            body.position.y = 0.8; group.add(body);
            const cabin = new THREE.Mesh(new THREE.BoxGeometry(1.8, 0.6, 2.5), new THREE.MeshBasicMaterial({ color: 0x000000 }));
            cabin.position.set(0, 1.5, -0.2); group.add(cabin);
            const tail = new THREE.Mesh(new THREE.BoxGeometry(2.0, 0.1, 0.1), new THREE.MeshBasicMaterial({ color: 0xff0000 }));
            tail.position.set(0, 0.8, 2.26); group.add(tail);
            const glow = new THREE.Mesh(new THREE.PlaneGeometry(2.2, 4.5), new THREE.MeshBasicMaterial({ color: color, transparent:true, opacity:0.5, side:THREE.DoubleSide }));
            glow.rotation.x = -Math.PI/2; glow.position.y = 0.1; group.add(glow);
            return group;
        }

        // ============================================================
        // 🚗 THEME 1: SUNSET DRIVE
        // ============================================================
        function startSunsetDrive(data) {
            initThreeJS(data, (scene, camera, renderer, composer, cMain, cAccent, intensity, bpm, time, delta) => {
                scene.fog = new THREE.FogExp2(cMain, 0.02); 
                camera.position.set(0, 3, 8); camera.lookAt(0, 1, -20);
                
                const sun = new THREE.Mesh(new THREE.CircleGeometry(40, 64), new THREE.MeshBasicMaterial({ color: cMain, fog: false }));
                sun.position.set(0, 20, -300); scene.add(해);
                
                const gridTex = createGridTexture(cAccent);
                const road = new THREE.Mesh(new THREE.PlaneGeometry(400, 1000), new THREE.MeshBasicMaterial({ map: gridTex, color: 0xffffff }));
                road.rotation.x = -Math.PI / 2; road.position.z = -200; scene.add(road);

                const carGroup = createCarObject(cAccent);
                scene.add(carGroup);

                const speed = (bpm / 60) * 1.5;
                const currentSpeed = speed + (intensity * 2.0);
                gridTex.offset.y -= currentSpeed * delta * 0.5;
                
                const sunScale = 1 + Math.sin(time * 10) * 0.05 * intensity;
                sun.scale.set(sunScale, sunScale, 1);
                
                carGroup.position.y = Math.sin(time * 50) * 0.02;
                carGroup.position.x = Math.sin(time * 0.5) * 0.5;
                camera.position.x = carGroup.position.x * 0.5;
                camera.lookAt(carGroup.position.x, 1, -50);
            });
        }

        // ============================================================
        // 👾 THEME 2: PIXEL LOFI (New: Retro 8-bit Night)
        // ============================================================
        function startPixelLofi(data) {
            // 1. 저해상도 캔버스 생성 (320x200 -> 확대해서 도트 느낌 냄)
            const width = 320;
            const height = 200;
            const canvas = document.createElement('canvas');
            canvas.width = width;
            canvas.height = height;
            const ctx = canvas.getContext('2d');
            
            // 도트 그래픽 설정 (안티앨리어싱 끔)
            ctx.imageSmoothingEnabled = false;

            // 빌딩 데이터 생성
            const buildings = [];
            for(let i=0; i<40; i++) {
                buildings.push({
                    x: i * 15,
                    w: 10 + Math.random() * 20,
                    h: 20 + Math.random() * 80,
                    layer: Math.floor(Math.random() * 3) + 1 // 1~3 원경
                });
            }

            // 비(Rain) 데이터
            const rain = [];
            for(let i=0; i<50; i++) rain.push({x: Math.random()*width, y: Math.random()*height, speed: 2+Math.random()*4});

            initThreeJS(data, (scene, camera, renderer, composer, cMain, cAccent, intensity, bpm, time, delta) => {
                if (!scene.userData.pixelPlane) {
                    scene.background = new THREE.Color(0x000000);
                    
                    const texture = new THREE.CanvasTexture(canvas);
                    // ★ 중요: 텍스처 필터링을 Nearest로 해야 도트가 깨지지 않고 선명하게 보임
                    texture.minFilter = THREE.NearestFilter;
                    texture.magFilter = THREE.NearestFilter;
                    
                    camera.position.set(0, 0, 10);
                    
                    const aspect = window.innerWidth / window.innerHeight;
                    const planeHeight = 20;
                    const planeWidth = planeHeight * aspect;
                    
                    const material = new THREE.MeshBasicMaterial({ map: texture, transparent: true });
                    const plane = new THREE.Mesh(new THREE.PlaneGeometry(planeWidth, planeHeight), material);
                    scene.add(plane);
                    scene.userData.pixelPlane = plane;
                    scene.userData.pixelTexture = texture;
                }

                // --- Canvas Drawing (Retro Pixel Art) ---
                
                // 1. 밤하늘 (그라데이션)
                const grad = ctx.createLinearGradient(0, 0, 0, height);
                grad.addColorStop(0, "#0a001a"); // Deep Purple
                grad.addColorStop(1, "#2a004a"); // Lighter Purple
                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, width, height);

                // 2. 달 (Moon) - 비트에 맞춰 커짐
                const moonPulse = 20 + (intensity * 10);
                ctx.fillStyle = "#fff";
                ctx.beginPath();
                ctx.arc(width - 50, 50, moonPulse, 0, Math.PI * 2);
                ctx.fill();
                // 달무리
                ctx.fillStyle = "rgba(255, 255, 255, 0.1)";
                ctx.beginPath();
                ctx.arc(width - 50, 50, moonPulse + 10, 0, Math.PI * 2);
                ctx.fill();

                // 3. 빌딩 숲 (Parallax Scroll)
                buildings.forEach(b => {
                    // 스크롤 속도 (레이어별 차등)
                    b.x -= delta * 10 * b.layer * (1 + intensity); 
                    if(b.x + b.w < 0) b.x = width; // 화면 밖으로 나가면 리셋

                    // 색상: 멀리 있을수록 어둡게
                    const colorVal = 50 + (b.layer * 40);
                    ctx.fillStyle = `rgb(${colorVal}, ${colorVal*0.5}, ${colorVal+50})`; 
                    
                    // 빌딩 그리기 (단순 사각형)
                    // 이퀄라이저처럼 약간씩 높이 변화
                    const bounce = Math.sin(time * 5 + b.x) * intensity * 5;
                    ctx.fillRect(b.x, height - b.h - bounce, b.w, b.h + bounce);
                    
                    // 창문 그리기 (반짝임)
                    if(Math.random() > 0.95) {
                        ctx.fillStyle = "#ffff00";
                        ctx.fillRect(b.x + 2, height - b.h + 5, 2, 2);
                    }
                });

                // 4. 비 (Rain) - 빗방울 그리기
                ctx.fillStyle = "rgba(200, 200, 255, 0.6)";
                rain.forEach(r => {
                    r.y += r.speed + (intensity * 5);
                    if(r.y > height) r.y = 0;
                    ctx.fillRect(r.x, r.y, 1, 3); // 1x3 픽셀 빗방울
                });

                // 5. CRT Scanline 효과 (TV 느낌)
                ctx.fillStyle = "rgba(0, 0, 0, 0.1)";
                for(let y=0; y<height; y+=2) {
                    ctx.fillRect(0, y, width, 1);
                }

                if(scene.userData.pixelTexture) {
                    scene.userData.pixelTexture.needsUpdate = true;
                }
            }, true); // usePixelArt = true
        }

        // ============================================================
        // 📟 THEME 3: CYBER MATRIX (Fixed: 2D Canvas Overlay)
        // ============================================================
        function startCyberMatrix(data) {
            // 1. 매트릭스 비 효과를 위한 2D 캔버스 생성
            const mCanvas = document.createElement('canvas');
            mCanvas.width = window.innerWidth;
            mCanvas.height = window.innerHeight;
            const mCtx = mCanvas.getContext('2d');
            
            // 2. 문자열 설정 (가타카나 + 숫자)
            const chars = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZｦｧｨｩｪｫｬｭｮｯｰｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ";
            const fontSize = 16;
            const columns = mCanvas.width / fontSize;
            const drops = [];
            for(let x=0; x<columns; x++) drops[x] = 1;

            // 3. Three.js 초기화 및 애니메이션 루프 연결
            initThreeJS(data, (scene, camera, renderer, composer, cMain, cAccent, intensity, bpm, time, delta) => {
                
                // (최초 1회 실행) 전체 화면을 덮는 평면 생성 -> 여기에 캔버스를 텍스처로 입힘
                if (!scene.userData.matrixPlane) {
                    scene.background = new THREE.Color(0x000000); // 완전 검은 배경
                    
                    // 캔버스 텍스처 생성
                    const texture = new THREE.CanvasTexture(mCanvas);
                    texture.minFilter = THREE.LinearFilter;
                    
                    // 카메라 앞에 딱 붙일 평면 (HUD 느낌)
                    camera.position.set(0, 0, 10);
                    camera.lookAt(0, 0, 0);

                    const aspect = window.innerWidth / window.innerHeight;
                    const planeHeight = 20; 
                    const planeWidth = planeHeight * aspect;
                    
                    const material = new THREE.MeshBasicMaterial({ 
                        map: texture, 
                        transparent: true,
                        side: THREE.DoubleSide 
                    });
                    const plane = new THREE.Mesh(new THREE.PlaneGeometry(planeWidth, planeHeight), material);
                    plane.position.z = 0; 
                    
                    scene.add(plane);
                    scene.userData.matrixPlane = plane;
                    scene.userData.matrixTexture = texture;
                }

                // --- 2D Matrix Rain Animation Logic ---
                
                // 배경을 약간 투명한 검은색으로 덮어 잔상(Trail) 효과 생성
                mCtx.fillStyle = 'rgba(0, 0, 0, 0.05)';
                mCtx.fillRect(0, 0, mCanvas.width, mCanvas.height);

                // 글자색: 비트가 강하면 밝은 흰색/연두색, 약하면 짙은 초록색
                if (intensity > 0.6) {
                    mCtx.fillStyle = '#ccffcc'; // 밝은 연두
                    mCtx.font = `bold ${fontSize}px monospace`;
                } else {
                    mCtx.fillStyle = '#0F0'; // 기본 초록
                    mCtx.font = `${fontSize}px monospace`;
                }

                for (let i = 0; i < drops.length; i++) {
                    const text = chars.charAt(Math.floor(Math.random() * chars.length));
                    mCtx.fillText(text, i * fontSize, drops[i] * fontSize);

                    // 떨어지는 로직
                    if (drops[i] * fontSize > mCanvas.height && Math.random() > 0.975) {
                        drops[i] = 0;
                    }

                    // 떨어지는 속도: 음악 강도(intensity)에 비례
                    const speed = 1 + Math.floor(intensity * 3); 
                    drops[i] += speed;
                }

                if(scene.userData.matrixTexture) {
                    scene.userData.matrixTexture.needsUpdate = true;
                }
            });
        }
    </script>
</body>
</html>