<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="utf-8">
    <title>Beat Visual: HYPER LOOP</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/EffectComposer.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/RenderPass.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/ShaderPass.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/CopyShader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/shaders/LuminosityHighPassShader.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/postprocessing/UnrealBloomPass.js"></script>

    <style>
        body {
            background-color: #000;
            margin: 0; padding: 0;
            overflow: hidden; height: 100vh;
            display: flex; align-items: center; justify-content: center;
            font-family: 'Montserrat', sans-serif;
        }
        #visualization-container { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; }

        /* 메인 컨테이너 */
        .container {
            background-color: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(10px);
            padding: 40px; border-radius: 20px;
            text-align: center; width: 450px;
            border: 1px solid rgba(255, 255, 255, 0.2);
            z-index: 100; position: relative;
            box-shadow: 0 0 30px rgba(0,0,0,0.5);
        }
        h1 { margin: 0 0 10px 0; font-size: 36px; color: #fff; font-weight: 800; letter-spacing: 2px; }
        p { color: #888; margin-bottom: 30px; font-size: 14px; text-transform: uppercase; }
        
        /* =========================================
           [수정 1] 파일 입력 & DIVE IN 버튼 스타일 통일
           ========================================= */
        .input-group {
            width: 100%;
            box-sizing: border-box; /* 테두리 포함 너비 계산 */
        }

        /* 파일 선택 박스 */
        input[type="file"] {
            width: 100%; 
            padding: 15px; 
            margin-bottom: 15px; /* 버튼과 간격 */
            background: #222; 
            border: 1px solid #444; 
            border-radius: 5px;
            color: #fff; 
            cursor: pointer;
            box-sizing: border-box; /* 중요: 패딩 포함 */
            font-size: 14px;
            text-align: center;
            display: block;
        }
        input[type="file"]::-webkit-file-upload-button { visibility: hidden; width: 0; padding: 0; }

        /* DIVE IN (제출) 버튼 - 전용 클래스 사용 */
        .submit-btn {
            background: #fff; 
            color: #000; 
            border: none; 
            border-radius: 5px;
            padding: 15px; 
            width: 100%; /* 가로 꽉 차게 */
            font-weight: 800; 
            font-size: 18px;
            text-transform: uppercase; 
            cursor: pointer; 
            transition: 0.2s;
            box-sizing: border-box;
            display: block;
        }
        .submit-btn:hover { transform: scale(1.02); box-shadow: 0 0 15px rgba(255,255,255,0.5); }


        /* =========================================
           [수정 2] STOP 버튼 (작게, 우측 하단 고정)
           ========================================= */
        .restart-btn { 
            position: fixed; /* 화면 기준 고정 */
            bottom: 30px; 
            right: 30px; 
            z-index: 9999; /* 최상단 */
            
            width: auto; /* 내용물만큼만 크기 잡기 */
            padding: 8px 20px; /* 작게 패딩 */
            
            background: rgba(0, 0, 0, 0.5); 
            border: 1px solid rgba(255, 255, 255, 0.5); 
            color: rgba(255, 255, 255, 0.8);
            
            font-size: 12px; 
            font-weight: 700; 
            letter-spacing: 1px;
            border-radius: 30px; 
            cursor: pointer; 
            transition: 0.3s;
            pointer-events: auto;
        }
        .restart-btn:hover { 
            background: #fff; 
            color: #000; 
            border-color: #fff;
            box-shadow: 0 0 10px rgba(255,255,255,0.5);
        }

        /* 로딩 화면 */
        #loading-section {
            position: absolute; width: 100%; height: 100%; z-index: 200; background: #000;
            display: none; flex-direction: column; align-items: center; justify-content: center;
        }
        .loader-text { color: #fff; font-size: 24px; font-weight: bold; letter-spacing: 5px; animation: blink 1s infinite; }
        @keyframes blink { 50% { opacity: 0.3; } }

        /* 결과 화면 UI 레이어 */
        #result-ui { position: absolute; width: 100%; height: 100%; z-index: 50; display: none; pointer-events: none; }
        
        .vibe-badge { 
            position: absolute; bottom: 40px; left: 40px;
            color: #fff; font-size: 3em; font-weight: 900;
            text-shadow: 0 0 20px rgba(255,255,255,0.8);
            mix-blend-mode: screen;
        }
        .vibe-sub { font-size: 14px; display: block; margin-top: 5px; opacity: 0.8; letter-spacing: 2px; }

        .server-indicator {
            position: fixed; top: 20px; right: 20px;
            color: #0f0; font-family: monospace; font-size: 12px; pointer-events: none; z-index: 9999;
        }
    </style>
</head>
<body>

    <div class="server-indicator">NODE: {{ inventory_hostname }}</div>

    <div id="upload-section" class="container">
        <h1>HYPER LOOP</h1>
        <p>Infinite Circular Tunnel</p>
        <form id="uploadForm" onsubmit="handleUpload(event)">
            <input type="file" id="fileInput" name="file" accept="audio/*" required>
            <button type="submit" class="submit-btn">DIVE IN 🌀</button>
        </form>
    </div>

    <div id="loading-section">
        <div class="loader-text">ANALYZING WAVEFORMS...</div>
    </div>

    <div id="visualization-container"></div>

    <div id="result-ui">
        <div id="vibe-display" class="vibe-badge"></div>
        <button class="restart-btn" onclick="location.reload()">STOP</button>
    </div>

    <script>
        const UPLOAD_URL = '/upload'; 
        const VISUAL_PATH = '/music-project/'; 
        let pollingInterval = null;

        async function handleUpload(event) {
            event.preventDefault(); 
            const fileInput = document.getElementById('fileInput');
            if (!fileInput.files[0]) return;
            document.getElementById('upload-section').style.display = 'none';
            document.getElementById('loading-section').style.display = 'flex';
            
            const formData = new FormData();
            formData.append('file', fileInput.files[0]);
            
            try {
                const response = await fetch(UPLOAD_URL, { method: 'POST', body: formData });
                if (response.ok) startPolling(); else throw new Error("Upload Failed");
            } catch (error) { 
                alert("Server Error"); location.reload(); 
            }
        }

        function startPolling() {
            setTimeout(() => {
                pollingInterval = setInterval(async () => {
                    try {
                        const res = await fetch(`${VISUAL_PATH}theme.json?t=${Date.now()}`);
                        if (res.status === 200) {
                            clearInterval(pollingInterval);
                            renderResult(await res.json());
                        }
                    } catch (e) {}
                }, 2000); 
            }, 30000); 
        }

        function renderResult(data) {
            const topMood = data.emotion_rankings[0];
            document.getElementById('vibe-display').innerHTML = 
                `${topMood.mood}<span class="vibe-sub">CONFIDENCE: ${topMood.confidence}</span>`;

            document.getElementById('loading-section').style.display = 'none';
            document.getElementById('result-ui').style.display = 'block';
            
            startCircularVisualizer(data);
        }

        // ============================================================
        // ★ [HYPER LOOP] 원형 웜홀 비주얼라이저
        // ============================================================
        function startCircularVisualizer(data) {
            const container = document.getElementById('visualization-container');
            container.innerHTML = ''; 

            const bpm = data.analysis.tempo || 120;
            const intensity = data.analysis.intensity; 
            const cMain = new THREE.Color(data.palette.main);
            const cAccent = new THREE.Color(data.palette.accent);
            
            const scene = new THREE.Scene();
            scene.fog = new THREE.FogExp2(0x000000, 0.02);

            const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
            
            const renderer = new THREE.WebGLRenderer({ antialias: true });
            renderer.setSize(window.innerWidth, window.innerHeight);
            renderer.toneMapping = THREE.ACESFilmicToneMapping;
            renderer.toneMappingExposure = 1.5;
            container.appendChild(renderer.domElement);

            const renderScene = new THREE.RenderPass(scene, camera);
            const bloomPass = new THREE.UnrealBloomPass(new THREE.Vector2(window.innerWidth, window.innerHeight), 1.5, 0.4, 0.85);
            bloomPass.strength = 1.5 + (intensity * 1.5); 
            bloomPass.radius = 0.4;
            bloomPass.threshold = 0;

            const composer = new THREE.EffectComposer(renderer);
            composer.addPass(renderScene);
            composer.addPass(bloomPass);

            const tunnelGroup = new THREE.Group();
            const count = 60; 
            const geometry = new THREE.TorusGeometry(4, 0.05, 16, 100); 

            const materialMain = new THREE.MeshBasicMaterial({ color: cMain, transparent: true, opacity: 0.8 });
            const materialAccent = new THREE.MeshBasicMaterial({ color: cAccent, transparent: true, opacity: 0.6 });

            const rings = [];
            for(let i = 0; i < count; i++) {
                const mat = (i % 2 === 0) ? materialMain : materialAccent;
                const mesh = new THREE.Mesh(geometry, mat);
                mesh.position.z = -i * 2; 
                rings.push(mesh);
                tunnelGroup.add(mesh);
            }
            scene.add(tunnelGroup);

            const starGeo = new THREE.BufferGeometry();
            const starCount = 2000;
            const starPos = new Float32Array(starCount * 3);
            for(let i=0; i<starCount*3; i++) { starPos[i] = (Math.random() - 0.5) * 100; }
            starGeo.setAttribute('position', new THREE.BufferAttribute(starPos, 3));
            const starMat = new THREE.PointsMaterial({ color: 0xffffff, size: 0.2, transparent: true });
            const starField = new THREE.Points(starGeo, starMat);
            scene.add(starField);

            const clock = new THREE.Clock();
            let baseSpeed = (bpm / 60) * 15; 

            function animate() {
                const delta = clock.getDelta();
                const time = clock.getElapsedTime();
                const currentSpeed = baseSpeed + (intensity * 20); 
                const shake = intensity * 0.3; 

                for(let i = 0; i < count; i++) {
                    const mesh = rings[i];
                    mesh.position.z += currentSpeed * delta;
                    mesh.rotation.z += delta * (0.5 + intensity);
                    const pulse = Math.sin((time * 5) + (i * 0.2)) * 0.5 + 1;
                    const scale = pulse + (intensity * 0.5);
                    mesh.scale.set(scale, scale, 1);
                    if(mesh.position.z > 5) { mesh.position.z = -(count * 2) + 5; }
                }

                starField.rotation.z -= delta * 0.2; 
                camera.position.x = Math.sin(time * 2) * shake;
                camera.position.y = Math.cos(time * 2) * shake;
                camera.rotation.z = Math.sin(time * 0.5) * shake * 0.5;

                composer.render();
                requestAnimationFrame(animate);
            }

            window.addEventListener('resize', () => {
                camera.aspect = window.innerWidth / window.innerHeight;
                camera.updateProjectionMatrix();
                renderer.setSize(window.innerWidth, window.innerHeight);
                composer.setSize(window.innerWidth, window.innerHeight);
            });

            animate();
        }
    </script>
</body>
</html>