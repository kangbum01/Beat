{
  "title": "MEDW-전체-서버-상태",
  "uid": "infra-overview",
  "panels": [
    {
      "title": "서버 생존 상태 (Up/Down)",
      "type": "stat",
      "targets": [{ "expr": "up{job='medw-targets'}" }]
    },
    {
      "title": "CPU 사용률 추이",
      "type": "timeseries",
      "targets": [{ "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode='idle'}[5m])) * 100)" }]
    }
  ]
}
