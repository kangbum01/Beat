{
  "title": "MEDW-로키-에러-분석",
  "uid": "log-analyzer",
  "panels": [
    {
      "title": "실시간 에러 로그 스트림",
      "type": "logs",
      "targets": [{ "expr": "{server_group=~'.*'} |= 'error' | json" }]
    },
    {
      "title": "최근 1시간 에러 발생 건수",
      "type": "timeseries",
      "targets": [{ "expr": "count_over_time({level='error_keyword'}[10m])" }]
    }
  ]
}
