[Unit]
Description=MinIO
After=network-online.target

[Service]
User={{ ansible_user }}
Group={{ ansible_user }}
Environment="MINIO_ROOT_USER={{ minio_root_user }}"
Environment="MINIO_ROOT_PASSWORD={{ minio_root_password }}"
ExecStart=/usr/local/bin/minio server {{ minio_data_path }} --address ":{{ minio_port | default(9000) }}" --console-address ":{{ minio_console_port | default(9001) }}"
Restart=always

[Install]
WantedBy=multi-user.target
